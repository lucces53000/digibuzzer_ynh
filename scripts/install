#!/bin/bash

source "$(dirname "$0")/_common.sh"

# Upstream routes and URL generation target the domain root; subpaths are unsupported.
if [ "${path%/}" != "" ]; then
    ynh_die "DigiBuzzer ne prend pas en charge les sous-chemins. Choisissez la racine / d'un domaine dédié."
fi

ynh_script_progression "Préparation des paramètres DigiBuzzer..."

port=$(ynh_app_setting_get --key=port)
if [ -z "$port" ]; then port=3000; fi
port_redis=$(ynh_app_setting_get --key=port_redis)
if [ -z "$port_redis" ]; then port_redis=16379; fi
ynh_app_setting_set --key=port --value="$port"
ynh_app_setting_set --key=port_redis --value="$port_redis"
db_pwd=$(ynh_string_random --length=48)
session_key=$(ynh_string_random --length=64)
ynh_app_setting_set --key=db_pwd --value="$db_pwd"
ynh_app_setting_set --key=session_key --value="$session_key"

ynh_script_progression "Installation des sources DigiBuzzer..."
ynh_setup_source --dest_dir="$install_dir"
mkdir -p "$data_dir/avatars"
chown -R "$app:$app" "$install_dir" "$data_dir"

ynh_script_progression "Installation des dépendances Node.js et compilation..."
install_node_dependencies
configure_runtime

ynh_script_progression "Configuration de DigiBuzzer..."
ynh_config_add --template="dotenv" --destination="$data_dir/.env"
chmod 600 "$data_dir/.env"
chown "$app:$app" "$data_dir/.env"
ynh_config_add_nginx
configure_systemd_runtime
yunohost service add "$app" --description="DigiBuzzer virtual game rooms" --log="systemd"

ynh_script_progression "Démarrage de DigiBuzzer..."
ynh_systemctl --service="$app" --action=start --log_path="systemd" --wait_until="Redis prêt" --timeout=120
